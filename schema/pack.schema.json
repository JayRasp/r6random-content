{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content pack",
  "description": "v1/packs/<version>.json: the complete resolved roster. Written by scripts/build.mjs. Attachments are expanded per weapon, defaults filled in, image paths point to hashed WebP files.",
  "type": "object",
  "properties": {
    "schema": { "const": 1 },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "label": { "$ref": "common.schema.json#/$defs/label" },
    "minApp": { "$ref": "common.schema.json#/$defs/appVersionCode" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/role" },
          "name": { "$ref": "common.schema.json#/$defs/text" }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "slot": { "$ref": "common.schema.json#/$defs/slot" },
          "name": { "$ref": "common.schema.json#/$defs/text" }
        },
        "required": ["id", "slot", "name"],
        "additionalProperties": false
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "legacyId": { "type": "string", "pattern": "^[ad]\\d+$" },
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "side": { "$ref": "common.schema.json#/$defs/side" },
          "type": { "enum": ["standard", "gadgetKit"] },
          "roles": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/role" },
            "minItems": 1
          },
          "armor": { "type": "integer", "minimum": 1, "maximum": 3 },
          "speed": { "type": "integer", "minimum": 1, "maximum": 3 },
          "released": { "$ref": "common.schema.json#/$defs/season" },
          "icon": { "$ref": "common.schema.json#/$defs/imagePath" },
          "ability": {
            "type": "object",
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "name": { "$ref": "common.schema.json#/$defs/text" },
              "icon": { "$ref": "common.schema.json#/$defs/imagePath" }
            },
            "required": ["id", "name", "icon"],
            "additionalProperties": false
          },
          "loadout": {
            "type": "object",
            "properties": {
              "primary": { "$ref": "common.schema.json#/$defs/idList", "minItems": 1 },
              "secondary": { "$ref": "common.schema.json#/$defs/idList" },
              "gadgets": { "$ref": "common.schema.json#/$defs/idList", "minItems": 1 },
              "gadgetPicks": { "type": "integer", "minimum": 1 }
            },
            "required": ["primary", "secondary", "gadgets", "gadgetPicks"],
            "additionalProperties": false
          },
          "aliases": { "$ref": "common.schema.json#/$defs/idList" }
        },
        "required": ["id", "name", "side", "type", "roles", "armor", "speed", "released", "icon", "ability", "loadout"],
        "additionalProperties": false
      }
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "slot": { "enum": ["primary", "secondary"] },
          "class": { "$ref": "common.schema.json#/$defs/weaponClass" },
          "icon": { "$ref": "common.schema.json#/$defs/imagePath" },
          "attachments": {
            "type": "object",
            "properties": {
              "sight": { "$ref": "common.schema.json#/$defs/idList" },
              "barrel": { "$ref": "common.schema.json#/$defs/idList" },
              "grip": { "$ref": "common.schema.json#/$defs/idList" },
              "underbarrel": { "$ref": "common.schema.json#/$defs/idList" }
            },
            "required": ["sight", "barrel", "grip", "underbarrel"],
            "additionalProperties": false
          },
          "aliases": { "$ref": "common.schema.json#/$defs/idList" }
        },
        "required": ["id", "name", "slot", "class", "icon", "attachments"],
        "additionalProperties": false
      }
    },
    "gadgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "side": { "$ref": "common.schema.json#/$defs/side" },
          "icon": { "$ref": "common.schema.json#/$defs/imagePath" },
          "aliases": { "$ref": "common.schema.json#/$defs/idList" }
        },
        "required": ["id", "name", "side", "icon"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "version", "label", "minApp", "roles", "attachments", "operators", "weapons", "gadgets"],
  "additionalProperties": false
}
